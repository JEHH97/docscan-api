{
  "openapi": "3.1.0",
  "info": {
    "title": "DocScan API",
    "description": "Asynchronous document cleanup and OCR with a stable, versioned contract.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:8000",
      "description": "Local development"
    }
  ],
  "paths": {
    "/v1/scans": {
      "post": {
        "tags": [
          "Scans"
        ],
        "summary": "Submit an image for asynchronous document scanning",
        "description": "Validate the upload, persist it, and enqueue background work.",
        "operationId": "submit_scan_v1_scans_post",
        "parameters": [
          {
            "name": "x-api-key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Api-Key"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_submit_scan_v1_scans_post"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Scan queued",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScanResponse"
                },
                "example": {
                  "id": "2f0e2e22-9b80-4db4-b997-f4b78d13c271",
                  "status": "queued",
                  "status_url": "/v1/scans/2f0e2e22-9b80-4db4-b997-f4b78d13c271",
                  "image_url": "/v1/scans/2f0e2e22-9b80-4db4-b997-f4b78d13c271/image"
                }
              }
            }
          },
          "400": {
            "description": "Callback URLs are disabled by WEBHOOKS_ENABLED"
          },
          "413": {
            "description": "Upload exceeds configured size limit"
          },
          "415": {
            "description": "Unsupported or invalid image"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/scans/{scan_id}": {
      "get": {
        "tags": [
          "Scans"
        ],
        "summary": "Read scan state and result",
        "description": "Return current state, OCR output, and timings for a scan.",
        "operationId": "get_scan_v1_scans__scan_id__get",
        "parameters": [
          {
            "name": "scan_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Scan Id"
            }
          },
          {
            "name": "x-api-key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Api-Key"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScanResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/scans/{scan_id}/image": {
      "get": {
        "tags": [
          "Scans"
        ],
        "summary": "Download the corrected PNG",
        "description": "Return the corrected page image after successful processing.",
        "operationId": "get_scan_image_v1_scans__scan_id__image_get",
        "parameters": [
          {
            "name": "scan_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Scan Id"
            }
          },
          {
            "name": "x-api-key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Api-Key"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              },
              "image/png": {}
            }
          },
          "404": {
            "description": "Scan or image not found"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/healthz": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Check API and Redis health",
        "description": "Return readiness status, including a Redis ping.",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Healthz Healthz Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Body_submit_scan_v1_scans_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File",
            "description": "JPEG, PNG, or WebP document image"
          },
          "callback_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Callback Url",
            "description": "Optional public HTTP(S) callback. Callbacks are rejected with HTTP 400 when WEBHOOKS_ENABLED is false (the public demo default)."
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_submit_scan_v1_scans_post"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "JobState": {
        "type": "string",
        "enum": [
          "queued",
          "processing",
          "done",
          "failed"
        ],
        "title": "JobState",
        "description": "Lifecycle values exposed by the API."
      },
      "Point": {
        "properties": {
          "x": {
            "type": "number",
            "title": "X"
          },
          "y": {
            "type": "number",
            "title": "Y"
          }
        },
        "type": "object",
        "required": [
          "x",
          "y"
        ],
        "title": "Point",
        "description": "Image coordinate in pixels."
      },
      "ScanResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "status": {
            "$ref": "#/components/schemas/JobState"
          },
          "result": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ScanResult"
              },
              {
                "type": "null"
              }
            ]
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          },
          "status_url": {
            "type": "string",
            "title": "Status Url"
          },
          "image_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Image Url"
          }
        },
        "type": "object",
        "required": [
          "id",
          "status",
          "created_at",
          "status_url"
        ],
        "title": "ScanResponse",
        "description": "Public scan state. Result is populated after successful completion."
      },
      "ScanResult": {
        "properties": {
          "text": {
            "type": "string",
            "title": "Text"
          },
          "mean_confidence": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Mean Confidence"
          },
          "word_boxes": {
            "items": {
              "$ref": "#/components/schemas/WordBox"
            },
            "type": "array",
            "title": "Word Boxes"
          },
          "page_corners": {
            "items": {
              "$ref": "#/components/schemas/Point"
            },
            "type": "array",
            "maxItems": 4,
            "minItems": 4,
            "title": "Page Corners"
          },
          "timings_ms": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "title": "Timings Ms"
          }
        },
        "type": "object",
        "required": [
          "text",
          "mean_confidence",
          "word_boxes",
          "page_corners",
          "timings_ms"
        ],
        "title": "ScanResult",
        "description": "OCR result and pipeline metadata."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "WordBox": {
        "properties": {
          "text": {
            "type": "string",
            "title": "Text"
          },
          "confidence": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Confidence"
          },
          "x": {
            "type": "integer",
            "minimum": 0.0,
            "title": "X"
          },
          "y": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Y"
          },
          "width": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Width"
          },
          "height": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Height"
          }
        },
        "type": "object",
        "required": [
          "text",
          "confidence",
          "x",
          "y",
          "width",
          "height"
        ],
        "title": "WordBox",
        "description": "Recognized word and its rectangular bounds in corrected-image pixels."
      }
    }
  },
  "tags": [
    {
      "name": "Scans",
      "description": "Submit and retrieve document scans."
    },
    {
      "name": "Health",
      "description": "Service readiness checks."
    }
  ]
}
