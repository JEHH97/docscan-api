#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
requested_out="${1:-/tmp/opencode/docscan-space}"
mkdir -p "$(dirname "$requested_out")"
out_parent="$(cd "$(dirname "$requested_out")" && pwd)"
out="$out_parent/$(basename "$requested_out")"

case "$out" in
  "$repo_root"|"$repo_root"/*)
    echo "Refusing to create a Space bundle inside the source checkout." >&2
    exit 1
    ;;
esac

if ! grep -Fq 'WEBHOOKS_ENABLED=false' "$repo_root/Dockerfile.spaces"; then
  echo "Dockerfile.spaces must disable callbacks for the public demo." >&2
  exit 1
fi

rm -rf -- "$out"
mkdir -p "$out/app" "$out/deploy"
cp "$repo_root/Dockerfile.spaces" "$out/Dockerfile"
cp "$repo_root/pyproject.toml" "$repo_root/requirements.txt" "$out/"
cp -R "$repo_root/app/." "$out/app/"
cp "$repo_root/deploy/supervisord.conf" "$out/deploy/supervisord.conf"
cp "$repo_root/deploy/hf-space/README.md" "$out/README.md"
printf 'Created Hugging Face Space bundle at %s\n' "$out"
